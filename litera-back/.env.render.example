# Variáveis de Ambiente para Deploy no Render (Backend Laravel + PostgreSQL)
# Copie estas chaves para Environment -> Environment Variables no seu Web Service do Render.

APP_NAME=LiteraAPI
APP_ENV=production
APP_KEY=base64:GERAR_OU_COPIAR_APP_KEY_AQUI
APP_DEBUG=false
APP_URL=https://SEU-BACKEND.onrender.com
FRONTEND_URL=https://portfolio-da-ana.onrender.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_URL=postgresql://USUARIO:SENHA@HOST/BANCO
DB_HOST=HOST_DO_POSTGRES_NO_RENDER
DB_PORT=5432
DB_DATABASE=db_litera
DB_USERNAME=db_litera_user
DB_PASSWORD=SUA_SENHA_DO_BANCO
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
